{
  "expo": {
    "name": "AskSAV",
    "slug": "asksav-mobile",
    "version": "4.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asksav",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ai.asksav.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "AskSAV uses your camera so you can photograph an item for identification, condition assessment and market insights.",
        "NSPhotoLibraryUsageDescription": "AskSAV accesses your photo library so you can choose an item photo to analyse.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.asksav.mobile",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FBFF",
          "image": "./assets/images/asksav-native-splash.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AskSAV accesses your photos so you can choose an item photo to analyse.",
          "cameraPermission": "AskSAV uses your camera so you can photograph an item to analyse.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c523426-b604-4022-8b5e-7c2df5ba2275"
      }
    }
  }
}
